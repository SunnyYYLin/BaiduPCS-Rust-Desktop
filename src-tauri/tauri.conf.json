{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaiduPCS-Rust",
  "version": "2.2.3",
  "identifier": "com.baidupcs.desktop",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../upstream/BaiduPCS-Rust/frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"],
        "upgradeCode": "8d7c4a1e-5f92-4c28-98e3-72b1b36b4129"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      }
    }
  }
}
